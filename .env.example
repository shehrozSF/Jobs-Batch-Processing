# Copy to .env. Only the API key is required; everything else has a default.

# From cloud.cerebras.ai. Billing must be enabled on the account, or every
# call returns HTTP 402 and the batch halts.
BATCH_API_KEY=

BATCH_MODEL=gpt-oss-120b

# Local defaults match docker-compose.yml (Postgres on 5433, Redis on 6379).
BATCH_DATABASE_URL=postgresql+psycopg://batch:batch@localhost:5433/batch
BATCH_REDIS_URL=redis://localhost:6379/0

# Shared across all workers. Cerebras' developer tier: 5/minute, 150/hour.
BATCH_REQUESTS_PER_MINUTE=2.5
BATCH_MAX_ATTEMPTS=3
